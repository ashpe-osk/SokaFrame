# Copy this file to .env and replace the placeholders before local development.
FASTAPI_ENV=development
PROJECT_NAME=omniBoard-Sportz
SECRET_KEY=replace-with-a-long-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-unique-password

# Use the directory containing this repository's main.py and models/ folder.
CV_REPO_ROOT=C:\path\to\omniBoard-Sportz
CV_PYTHON_EXECUTABLE=C:\path\to\omniBoard-Sportz\.venv-1\Scripts\python.exe
CV_ENTRYPOINT=main.py
CV_DEFAULT_MODEL=models/best.pt
CV_DEFAULT_BACKEND=auto

DATABASE_URL=sqlite:///./sql_app.db
LOCAL_DATA_DIR=local-data
